# Authentication Credentials for Web App
USER_WEB=admin
USER_PASSWORD=admin

# Target Raspberry Pi Backend (Updated to Pi 4)
BECKEND_RPI_IP=192.168.88.21
BECKEND_RPI_PORT=5000

# Full System Inactivity Timeout (Seconds) - Powers off camera and entire system after 10 minutes (600s)
INACTIVITY_TIME=600

# Frontend Server Settings
FRONTEND_PORT=8080
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-12345

# Camera Hardware Defaults
# ANTI_FLICKER options: 50 (50 Hz), 60 (60 Hz), 0 (Disabled)
ANTI_FLICKER=50

# Camera Stream Resolution (Matches exact resolution format like 1920x1080, 3840x2160 for 4K, 1280x720, etc.)
DEFAULT_RESOLUTION=1920x1080

# WS2812B NeoPixel Defaults
LED_BRIGHTNESS=45
DEFAULT_LED_COLOR=WHITE
# LED Auto-Off (Seconds) - Automatically turns off WS2812B LEDs after 2 minutes (120s) while camera stays active
LED_AUTO_OFF=120
LED_LENGTH=100

# OCR Security Access Password (Prompted when user clicks OCR button)
OCR_PASSWORD=admin
