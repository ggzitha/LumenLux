# ==========================================
# Authentication & Security Credentials
# ==========================================
USER_WEB=admin
USER_PASSWORD=admin
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-12345

# OCR Security Access Password (Prompted when user opens OCR feature)
OCR_PASSWORD=admin

# ==========================================
# Backend Raspberry Pi Target
# ==========================================
BECKEND_RPI_IP=192.168.88.21
BECKEND_RPI_PORT=5000

# Client watchdog timeout in seconds on Raspberry Pi server (powers off camera & LEDs if idle)
CLIENT_WATCHDOG_TIMEOUT=15

# ==========================================
# go2rtc H.264 WebRTC Streaming Engine
# ==========================================
GO2RTC_HOST=10.101.27.3:1984
DEFAULT_STREAM_ENGINE=webrtc

# ==========================================
# Frontend Server & Network Configuration
# ==========================================
FRONTEND_PORT=8080

# Full System Inactivity Timeout (Seconds) - Powers off camera and all hardware after idle (default: 600s / 10 mins)
INACTIVITY_TIME=600

# Docker Bridge Network (10.101.27.0/24)
DOCKER_SUBNET=10.101.27.0/24
DOCKER_CONTAINER_IP=10.101.27.2
DOCKER_GATEWAY_IP=10.101.27.1

# Optional extra comma-separated subnets allowed through LAN whitelist filter
EXTRA_ALLOWED_NETWORKS=10.101.27.0/24,10.101.29.0/24

# ==========================================
# Camera Hardware Defaults
# ==========================================
# Anti-flicker options: 50 (50 Hz), 60 (60 Hz), 0 (Disabled)
ANTI_FLICKER=50

# Camera Stream Resolution (Matches exact resolution format like 1920x1080, 3840x2160 for 4K, 1280x720, etc.)
DEFAULT_RESOLUTION=1920x1080

# Device Camera (Webcam / Smartphone) Framing Mode: cover (Fill / Crop to 16:9) or contain (Fit / Full View)
DEFAULT_DEVICE_CAM_FIT=contain

# ==========================================
# WS2812B NeoPixel LED Strip Defaults
# ==========================================
LED_BRIGHTNESS=45
DEFAULT_LED_COLOR=WHITE
# LED Auto-Off (Seconds) - Automatically turns off WS2812B LEDs after 2 minutes (120s) while camera stays active
LED_AUTO_OFF=120
LED_LENGTH=100

# ==========================================
# Persistent Volumes: Data, Images, Projects, Models & OCR Tesseract
# ==========================================
DATA_DIR=/app/data
IMAGES_DIR=/app/data/images
PROJECTS_DIR=/app/data/projects
MODELS_DIR=/app/data/models
TESSDATA_DIR=/app/data/tessdata

# ==========================================
# AI OCR Model Architecture:
# - v6_small  (Recommended: PP-OCRv6 Small ~31MB, ~7ms inference, fast & light)
# - v6_tiny   (PP-OCRv6 Tiny ~6.2MB, ~1.5ms inference, lowest RAM)
# - v6_medium (PP-OCRv6 Medium ~138MB, server tier model)
# - v4        (PP-OCRv4 Lightweight ~15.5MB, highly optimized on CPU)
# ==========================================
OCR_MODEL_VERSION=v6_small
ONNX_CPU_THREADS=4


